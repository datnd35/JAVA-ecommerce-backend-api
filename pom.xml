<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot Parent -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <!-- Project information -->
    <groupId>com.myshop</groupId>
    <artifactId>lumora-platform</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>Lumora Platform</name>
    <description>
        Lumora — Java/Spring Boot microservices platform (migrated from Open4Talk), formerly
        "JAVA-ecommerce-backend-api-MEMBER". groupId com.myshop and Java package names are kept
        unchanged in this rename pass; only the project/module/folder naming was updated.
    </description>

    <!-- Root project = aggregator -->
    <packaging>pom</packaging>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- Modules -->
    <modules>
        <module>lumora-framework</module>
        <module>lumora-module-manager</module>
        <module>lumora-media-common</module>
        <module>lumora-media-service</module>
        <module>lumora-media-worker</module>
        <module>lumora-ai-evaluation-service</module>
    </modules>

</project>